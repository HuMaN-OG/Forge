# FORGE AI Backend Configuration
PORT=3000
HOST=127.0.0.1
NODE_ENV=development

# Ollama Local AI Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b
OLLAMA_TIMEOUT_MS=120000

# Python Automation Service Configuration (Priyanshu)
PYTHON_AUTOMATION_URL=http://127.0.0.1:8000
FORGE_AUTOMATION_TOKEN=your_secret_token_here

# SQLite Persistence Path
SQLITE_DB_PATH=./data/forge.db

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
